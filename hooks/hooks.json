{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|apply_patch|write|edit|bash|powershell|pwsh)$",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${GIS_PLUGIN_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect_sources.py\"; $p = $env:GIS_PLUGIN_PYTHON, 'python' -match '.'; . $p[0] \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect_sources.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${GIS_PLUGIN_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject_describe.py\"; $p = $env:GIS_PLUGIN_PYTHON, 'python' -match '.'; . $p[0] \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject_describe.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "exec \"${GIS_PLUGIN_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject_style.py\"; $p = $env:GIS_PLUGIN_PYTHON, 'python' -match '.'; . $p[0] \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject_style.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell|bash|powershell|pwsh|Read|read)$",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${GIS_PLUGIN_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject_describe.py\"; $p = $env:GIS_PLUGIN_PYTHON, 'python' -match '.'; . $p[0] \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject_describe.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|Bash|PowerShell|apply_patch|write|edit|bash|powershell|pwsh)$",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${GIS_PLUGIN_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_artifact_text.py\"; $p = $env:GIS_PLUGIN_PYTHON, 'python' -match '.'; . $p[0] \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_artifact_text.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
