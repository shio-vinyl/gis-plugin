{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|apply_patch|write|edit|bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${GIS_PLUGIN_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect_sources.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
